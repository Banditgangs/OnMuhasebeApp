<UserControl x:Class="OnMuhasebeApp.Presentation.Views.KasaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="10" Padding="25" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="GÜNCEL TOPLAM BAKİYE" Foreground="#AAB7B8" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ToplamBakiye, StringFormat={}{0:N2} ₺, TargetNullValue='0,00 ₺'}" 
                               Foreground="#2ECC71" FontSize="42" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Gelir Ekle" Background="#27AE60" Foreground="White" Width="130" Height="45" FontSize="15" FontWeight="Bold" BorderThickness="0" Margin="0,0,15,0" Cursor="Hand"/>
                    <Button Content="- Gider Ekle" Background="#E74C3C" Foreground="White" Width="130" Height="45" FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1" ItemsSource="{Binding KasaIslemleri}" AutoGenerateColumns="False" IsReadOnly="True" Background="White" BorderThickness="1" BorderBrush="#DDD" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="130"/>
                <DataGridTextColumn Header="İşlem Türü" Binding="{Binding IslemTuru}" Width="100"/>
                <DataGridTextColumn Header="Açıklama / Cari" Binding="{Binding Aciklama}" Width="*"/>
                <DataGridTextColumn Header="Tutar" Binding="{Binding Tutar, StringFormat={}{0:N2} ₺}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,5,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>