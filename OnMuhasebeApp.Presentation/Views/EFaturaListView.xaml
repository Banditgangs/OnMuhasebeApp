<UserControl x:Class="OnMuhasebeApp.Presentation.Views.EFaturaListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="E-Fatura Yönetim Paneli" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>

            <Button Grid.Column="2" Content="GİB'den Sorgula" Width="130" Height="35" Margin="10,0,0,0" 
                    Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                    Command="{Binding FetchInvoicesCommand}"/>
                    
            <Button Grid.Column="3" Content="Veritabanına Kaydet" Width="140" Height="35" Margin="10,0,0,0" 
                    Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                    Command="{Binding SaveToDbCommand}"/>

            <Button Grid.Column="4" Content="Kayıtlıları Getir" Width="130" Height="35" Margin="10,0,0,0" 
                    Background="#9B59B6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                    Command="{Binding LoadFromDbCommand}"/>
        </Grid>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Faturalar}" AutoGenerateColumns="False" 
                  IsReadOnly="True" HeadersVisibility="Column" Background="White" 
                  BorderBrush="#DCDDE1" BorderThickness="1" RowHeight="35">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fatura No" Binding="{Binding FaturaNo}" Width="1.5*" />
                <DataGridTextColumn Header="Düzenlenme Tarihi" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy}" Width="1*" />
                <DataGridTextColumn Header="Toplam Tutar" Binding="{Binding ToplamTutar, StringFormat={}{0:N2} TL}" Width="1*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>