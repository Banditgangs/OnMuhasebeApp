<Window x:Class="OnMuhasebeApp.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OnMuhasebeApp.Presentation.Views"
        xmlns:viewmodels="clr-namespace:OnMuhasebeApp.Presentation.ViewModels"
        Title="Ön Muhasebe Uygulaması v1.0" Height="700" Width="1200" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:CariListViewModel}">
            <views:CariListView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type viewmodels:KasaViewModel}">
            <views:KasaView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:EFaturaListViewModel}">
            <views:EFaturaListView /> 
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="MENÜ" Foreground="#AAB7B8" FontSize="14" FontWeight="Bold" Margin="20,0,0,20"/>
                
                <Button Content="👥 Cariler" Command="{Binding ShowCariCommand}" 
                        Background="Transparent" Foreground="White" FontSize="16" Height="50" HorizontalContentAlignment="Left" Padding="20,0,0,0" BorderThickness="0" Cursor="Hand"/>
                
                <Button Content="💰 Kasa İşlemleri" Command="{Binding ShowKasaCommand}" 
                        Background="Transparent" Foreground="White" FontSize="16" Height="50" HorizontalContentAlignment="Left" Padding="20,0,0,0" BorderThickness="0" Cursor="Hand"/>

                <Button Content="📧 e-Faturalar" Command="{Binding ShowEFaturaCommand}" 
                        Background="Transparent" Foreground="White" FontSize="16" Height="50" HorizontalContentAlignment="Left" Padding="20,0,0,0" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
    </Grid>
</Window>